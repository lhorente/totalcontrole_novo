# Nome do projeto Compose -- isola rede, volume e tag de imagem entre
# ambientes (prod, qa, ...) rodando no mesmo host. Use um valor diferente
# por ambiente (ex.: totalcontrole_qa).
COMPOSE_PROJECT_NAME=totalcontrole

# Portas expostas no host. Cada ambiente precisa de portas próprias para
# coexistir no mesmo servidor.
DB_HOST_PORT=3310
V1_HTTP_PORT=8091
V2_HTTP_PORT=8092

# v1 (CakePHP legado) só sobe se este profile estiver ativo. Deixe comentado
# (ou remova) para subir só o v2 -- é o caso recomendado para QA.
# COMPOSE_PROFILES=v1

MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

DB_HOST=totalcontrole_db
DB_DATABASE=your_database_name
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password