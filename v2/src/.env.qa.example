# Template do .env do Laravel (v2) para QA.
#
# Uso: no clone do QA, copie para v2/src/.env:
#   cp v2/src/.env.qa.example v2/src/.env
# Depois gere uma APP_KEY própria (NUNCA reaproveite a de produção):
#   docker compose exec -u www-data total_controle_v2 php artisan key:generate

APP_NAME="Total Controle (QA)"
APP_ENV=qa
APP_KEY=
APP_DEBUG=true
# Troque pelo subdominio de QA quando o reverse proxy estiver configurado
# (Etapa 4). Até lá, dá pra acessar direto por http://SEU_SERVIDOR:8192.
APP_URL=http://qa.totalcontrole.com.br

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=totalcontrole_db
DB_PORT=3306
DB_DATABASE=totalcontrole_qa
DB_USERNAME=totalcontrole_qa
DB_PASSWORD=defina_uma_senha_qa

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# "log" em vez de "smtp": evita disparo de e-mail real (ex. redefinição de
# senha, 2FA) a partir do ambiente de QA. Troque para smtp se precisar
# testar esse fluxo de verdade.
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Pluggy (sincronização bancária real via Open Finance): propositalmente
# em branco. O container `total_controle_v2_scheduler` (que dispara
# `pluggy:sync-transactions` diariamente) não deve subir em QA -- suba só
# db + v2:
#   docker compose up -d totalcontrole_db total_controle_v2
# Se algum dia precisar testar a integração Pluggy de verdade em QA, use
# credenciais de sandbox aqui, nunca as de produção.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
