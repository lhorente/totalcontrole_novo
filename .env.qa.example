# Template do .env de QA (nível Docker Compose).
#
# Uso: em um clone separado do repositório no servidor (ex.: /opt/totalcontrole-qa),
# copie este arquivo para `.env` e ajuste as senhas:
#   cp .env.qa.example .env
#
# Este QA sobe com project name, portas e volume de banco próprios -- nunca
# compartilha rede/volume/imagem com o .env de produção, mesmo rodando no
# mesmo host Docker (ver comentário sobre isso em docker-compose.yml).

COMPOSE_PROJECT_NAME=totalcontrole_qa

# Portas expostas no host -- diferentes das de produção (3310/8091/8092)
# para poder rodar os dois ambientes ao mesmo tempo no mesmo servidor.
DB_HOST_PORT=3311
V1_HTTP_PORT=8191
V2_HTTP_PORT=8192

# v1 (CakePHP legado) não sobe em QA -- não defina COMPOSE_PROFILES aqui.

# Banco: instância MySQL própria do QA (container/volume dedicados, nada
# compartilhado com produção), com nome de banco/usuário próprios.
MYSQL_ROOT_PASSWORD=defina_uma_senha_qa
MYSQL_DATABASE=totalcontrole_qa
MYSQL_USER=totalcontrole_qa
MYSQL_PASSWORD=defina_uma_senha_qa

DB_HOST=totalcontrole_db
DB_DATABASE=totalcontrole_qa
DB_USERNAME=totalcontrole_qa
DB_PASSWORD=defina_uma_senha_qa
